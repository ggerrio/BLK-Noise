# Copy to .env and fill in real values. Never commit .env.

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gemini model id used for generation
GEMINI_MODEL=gemini-3.8-flash

# SQLite database file (relative to project root)
DB_PATH=data/listings.db

# Base URL of the FastAPI service the Streamlit UI calls
API_URL=http://localhost:8000

# Default number of results to return when the caller does not specify
TOP_N_DEFAULT=5
